# Kopiera till .env.

# Databasen. Krävs för allt utom demoläget.
DATABASE_URL=postgres://mittochditt:byt-mig@localhost:5432/mittochditt

# Adressen tjänsten nås på. Används i inbjudningslänkar och i csrf-kontrollen,
# som annars skulle jämföra mot appens interna adress bakom proxyn.
APP_URL=https://mittochditt.goodstuff.se

# Domänen Caddy skaffar certifikat för.
APP_DOMAIN=mittochditt.goodstuff.se

# Var bilagor sparas. Ligger utanför webbroten och nås bara genom
# behörighetskontrollerad nedladdning.
UPLOADS_DIR=./uploads

# Demoläge kör hela gränssnittet utan databas, med exempeldata.
# Lämna tomt i drift.
VITE_DEMO=

# Seed: bara åtkomst för den första installationen. Bostads- och avtalsuppgifter
# fyller parterna själva i tjänsten.
SEED_ADMIN_EMAIL=admin@example.se
SEED_CAESAR_EMAIL=caesar@example.se
# Valfri. Lämna tom om Caesar ska bjuda in Felicia från tjänsten.
SEED_FELICIA_EMAIL=

# Testerna för radnivåsäkerhet kör mot en riktig Postgres.
# Utan denna används en lokal server på /tmp:5433.
TEST_DATABASE_URL=
