# Kopiera till .env.

# Databasen. Krävs för allt utom demoläget.
DATABASE_URL=postgres://mittochditt:byt-mig@localhost:5432/mittochditt

# Adressen tjänsten nås på. Används i inbjudningslänkar och i csrf-kontrollen,
# som annars skulle jämföra mot appens interna adress bakom proxyn.
APP_URL=https://mittochditt.goodstuff.se

# Domänen Caddy skaffar certifikat för.
APP_DOMAIN=mittochditt.goodstuff.se

# Var bilagor sparas. Ligger utanför webbroten och nås bara genom
# behörighetskontrollerad nedladdning.
UPLOADS_DIR=./uploads

# Demoläge kör hela gränssnittet utan databas, med exempeldata.
# Lämna tomt i drift.
VITE_DEMO=

# Seed: bara åtkomst för den första installationen. Bostads- och avtalsuppgifter
# fyller parterna själva i tjänsten.
SEED_ADMIN_EMAIL=admin@example.se
SEED_CAESAR_EMAIL=caesar@example.se
# Valfri. Lämna tom om Caesar ska bjuda in Felicia från tjänsten.
SEED_FELICIA_EMAIL=

# ----------------------------------------------------------------- E-post
# Riktiga värden sätts bara i serverns skyddade miljöfil, aldrig här och aldrig
# i Git. Fälten nedan är tomma med flit.

SMTP_HOST=
# 465 med implicit TLS, eller 587 med StartTLS.
SMTP_PORT=465
# Lämna tom så följer den porten: true för 465, false för 587.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

# Avsändare och svarsadress. Till exempel: Mitt & Ditt <namn@example.se>
MAIL_FROM=
MAIL_REPLY_TO=

# Krypterar köade mail som bär en inbjudnings- eller återställningslänk.
# 32 byte i base64. Skapa en egen: openssl rand -base64 32
MAIL_QUEUE_ENCRYPTION_KEY=

# Hur ofta utkorgen töms. 0 stänger av avsändaren, vilket är standard så att
# varken tester eller en halvfärdig uppsättning kan börja skicka av misstag.
MAIL_DISPATCH_INTERVAL_SECONDS=0

# Väljer transport. Tomt betyder SMTP. "console" skriver mailet i loggen,
# "memory" sparar det i minnet. Använd aldrig något annat än tomt i drift.
MAIL_TRANSPORT=

# --------------------------------------------------- Kopia utanför servern
# Kopian krypteras på servern innan den skickas, så lagringen ser aldrig
# innehållet. Utan båda värdena hoppas steget över med ett meddelande i loggen.
# Förvara lösenfrasen någon annanstans än på servern.
BACKUP_PASSPHRASE=
BACKUP_REMOTE=

# Varning när disken är så här full. Standard 85.
DISK_WARN_PERCENT=

# Testerna för radnivåsäkerhet kör mot en riktig Postgres.
# Utan denna används en lokal server på /tmp:5433.
TEST_DATABASE_URL=
