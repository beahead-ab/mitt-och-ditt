# Kopiera till .env och fyll i från ditt Supabase-projekt (Settings → API).
# Klienten använder VITE_-varianterna; serverfunktioner använder de utan prefix.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Service role-nyckeln används ENDAST av serverfunktioner. Aldrig VITE_-prefix.
SUPABASE_SECRET_KEY=
# Sätt till 1 för att köra UI:t utan Supabase (demoläge med fixturdata).
VITE_DEMO=
